# ============================================
# HOLY MONTH AI - ENVIRONMENT VARIABLES
# ============================================
# Copy this to .env and add your REAL keys.
# NEVER commit .env to GitHub!
# On Streamlit Cloud, do NOT use this file — put the
# same keys in the app's "Secrets" panel instead
# (see .streamlit/secrets.toml.example).

# GEMINI (get from: https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# YOUTUBE (get from: https://console.cloud.google.com/)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# TELEGRAM (get from: @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# FFMPEG - leave blank on Linux/Streamlit Cloud (ffmpeg is
# installed via packages.txt and auto-found on PATH).
# Only set this on Windows if ffmpeg isn't on PATH, e.g.:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# SYSTEM (optional - defaults are fine)
DATABASE_URL=sqlite:///./holy_month.db
OUTPUT_FOLDER=output_videos
PUBLISH_HOUR=8
REQUIRE_HUMAN_REVIEW=true
